# === status ===
cmd_status() {
    local watch="$1"
    while true; do
        local inbox=$(count_files "$WORK/inbox")
        local by_date=$(count_files "$WORK/by-date")
        local trash=$(count_files "$WORK/_trash")
        local screenshots=$(count_files "$WORK/screenshots")
        local vlogs=$(count_files "$WORK/_vlogs")
        local stars=$(count_starred "$WORK/_meta/stars")
        local last_sync=$(last_sync_time "$WORK/_meta/logs")

        echo ""
        echo -e "${BOLD}📊 PicVault Status${NC}  ${BLUE}$WORK${NC}"
        echo "─────────────────────────────────────────"
        printf "  inbox:        %6d files\n" "$inbox"
        printf "  by-date:      %6d files\n" "$by_date"
        printf "  screenshots:  %6d files\n" "$screenshots"
        printf "  _vlogs:       %6d files\n" "$vlogs"
        printf "  _trash:       %6d files\n" "$trash"
        printf "  _favorite:    %6d stars\n"  "$stars"
        echo "─────────────────────────────────────────"
        echo "  Last sync log: $last_sync"

        local web_pid_file="$WORK/_meta/web.pid"
        if [ -f "$web_pid_file" ] && kill -0 "$(cat "$web_pid_file")" 2>/dev/null; then
            local web_port
            web_port="$(web_current_port 2>/dev/null || echo 8765)"
            echo -e "  Web UI:        ${GREEN}running${NC} (pid $(cat "$web_pid_file")) http://localhost:$web_port/"
        else
            echo -e "  Web UI:        ${YELLOW}not running${NC}  →  picvault web start"
        fi

        [ "$watch" = "--watch" ] || break
        sleep 3
    done
    echo ""
}

# === init ===
cmd_init() {
    local with_examples=""
    [ "$1" = "--with-example-themes" ] && with_examples="--with-example-themes"
    bash "$SCRIPTS_DIR/init_storage.sh" --work "$WORK" $with_examples
}

# === dedupe ===
cmd_dedupe() {
    local dry_run="--dry-run"
    [ "$1" = "--yes" ] && dry_run=""
    if [ -n "$dry_run" ]; then
        warn "Running in dry-run mode (no files moved). Use --yes to actually move duplicates."
    fi
    python3 "$SCRIPTS_DIR/dedupe.py" --work "$WORK" $dry_run
}

# === rename ===
cmd_rename() {
    local yes=""
    [ "$1" = "--yes" ] && yes="--yes"
    if [ -z "$yes" ]; then
        warn "Running in dry-run mode. Use --yes to actually move files."
        python3 "$SCRIPTS_DIR/rename_organize.py" --work "$WORK" --dry-run
    else
        python3 "$SCRIPTS_DIR/rename_organize.py" --work "$WORK"
    fi
}

# === sync ===
cmd_sync() {
    local verify=""
    local yes=""
    local backup="${BACKUP:-${PICVAULT_BACKUP:-/Volumes/WD4T/MediaVault}}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --verify) verify="--verify"; shift ;;
            --yes) yes="--yes"; shift ;;
            *) err "Unknown sync option: $1"; return 1 ;;
        esac
    done
    if [ -z "$yes" ]; then
        warn "Running in dry-run mode. Use --yes to actually sync."
        bash "$SCRIPTS_DIR/sync_to_backup.sh" --work "$WORK" --backup "$backup" --dry-run
    else
        bash "$SCRIPTS_DIR/sync_to_backup.sh" --work "$WORK" --backup "$backup" $verify
    fi
}

# === pipeline ===
cmd_pipeline() {
    local yes=""
    [ "$1" = "--yes" ] && yes="--yes"
    info "Starting full pipeline..."
    cmd_dedupe $yes
    cmd_rename $yes
    # Align with dashboard sync_apply: always verify on real sync; fail pipeline if verify fails
    if [ -n "$yes" ]; then
        cmd_sync --verify --yes
    else
        cmd_sync
    fi
    ok "Pipeline complete"
}

# === web ===
cmd_web() {
    local action="${1:-}"
    if [ -z "$action" ]; then
        err "Usage: picvault web {start|stop|restart|status|logs|open} [--port N]"
        return 1
    fi
    shift
    local port=""
    local follow=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --port)
                if [ -z "${2:-}" ]; then
                    err "--port requires a value"
                    return 1
                fi
                port="$2"; shift 2 ;;
            --follow|-f) follow="--follow"; shift ;;
            *) shift ;;
        esac
    done

    local pid_file="$WORK/_meta/web.pid"
    local port_file="$WORK/_meta/web.port"
    local log_file="$WORK/_meta/logs/web.log"
    local stored_port
    stored_port="$(web_current_port 2>/dev/null || true)"

    case "$action" in
        start)
            [ -n "$port" ] || port="8765"
            # Ensure dirs exist
            mkdir -p "$WORK/_meta/logs" "$WORK/_meta/thumbs"
            if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
                warn "Web UI already running (pid $(cat "$pid_file"))"
                return
            fi
            nohup python3 "$SCRIPTS_DIR/web_browse.py" \
                --work "$WORK" --host 127.0.0.1 --port "$port" \
                > "$log_file" 2>&1 &
            echo $! > "$pid_file"
            sleep 1
            if kill -0 "$(cat "$pid_file")" 2>/dev/null; then
                echo "$port" > "$port_file"
                ok "Web UI started (pid $(cat "$pid_file"))"
                info "Open: http://localhost:$port/"
            else
                rm -f "$pid_file" "$port_file"
                err "Web UI failed to start. Check: tail $log_file"
            fi
            ;;
        stop)
            if [ ! -f "$pid_file" ]; then
                warn "Web UI not running (no pid file)"
                return
            fi
            local pid=$(cat "$pid_file")
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid"
                ok "Web UI stopped (pid $pid)"
            else
                warn "Web UI process not running (stale pid file)"
            fi
            rm -f "$pid_file" "$port_file"
            ;;
        restart)
            [ -n "$port" ] || port="${stored_port:-8765}"
            cmd_web stop
            sleep 1
            cmd_web start --port "$port"
            ;;
        status)
            [ -n "$port" ] || port="${stored_port:-8765}"
            if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
                ok "Web UI running (pid $(cat "$pid_file"))"
                info "URL: http://localhost:$port/"
            else
                warn "Web UI not running"
            fi
            ;;
        logs)
            [ -f "$log_file" ] || { err "No log file: $log_file"; return; }
            if [ "$follow" = "--follow" ]; then
                tail -f "$log_file"
            else
                tail -50 "$log_file"
            fi
            ;;
        open)
            [ -n "$port" ] || port="${stored_port:-8765}"
            url="http://localhost:$port/"
            open "$url" 2>/dev/null || xdg-open "$url" 2>/dev/null || echo "Open manually: $url"
            ;;
        *)
            err "Unknown web action: $action"
            info "Try: picvault web {start|stop|restart|status|logs|open}"
            return 1
            ;;
    esac
}

# === star / unstar ===
cmd_star() {
    local bucket="$1"
    local file="$2"
    if [ -z "$bucket" ] || [ -z "$file" ]; then
        err "Usage: picvault star <bucket> <file>"
        return 1
    fi
    sanitize_bucket "$bucket" || return 1
    local rel_file
    if ! rel_file="$(resolve_work_rel_path "$file" 1)"; then
        err "invalid file for star: $file"
        return 1
    fi
    local stars_file="$WORK/_meta/stars/${bucket}.json"
    mkdir -p "$(dirname "$stars_file")"
    if [ ! -f "$stars_file" ]; then
        echo "{}" > "$stars_file"
    fi
    python3 -c "
import json, sys
p = sys.argv[1]
with open(p) as f: stars = json.load(f)
stars[sys.argv[2]] = True
with open(p, 'w') as f: json.dump(stars, f, indent=2, ensure_ascii=False)
" "$stars_file" "$rel_file"
    ok "Starred: $rel_file → $bucket"
}

cmd_unstar() {
    local bucket="$1"
    local file="$2"
    if [ -z "$bucket" ] || [ -z "$file" ]; then
        err "Usage: picvault unstar <bucket> <file>"
        return 1
    fi
    sanitize_bucket "$bucket" || return 1
    local rel_file
    if ! rel_file="$(resolve_work_rel_path "$file" 0)"; then
        err "invalid file for unstar: $file"
        return 1
    fi
    local stars_file="$WORK/_meta/stars/${bucket}.json"
    [ -f "$stars_file" ] || { warn "No stars for $bucket"; return; }
    python3 -c "
import json, sys
p = sys.argv[1]
with open(p) as f: stars = json.load(f)
stars.pop(sys.argv[2], None)
with open(p, 'w') as f: json.dump(stars, f, indent=2, ensure_ascii=False)
" "$stars_file" "$rel_file"
    ok "Unstarred: $rel_file"
}

cmd_favorites() {
    echo ""
    echo -e "${BOLD}★ Favorites${NC}"
    echo "─────────────────────────────────────────"
    local total=0
    for f in "$WORK/_meta/stars/"*.json; do
        [ -f "$f" ] || continue
        local bucket=$(basename "$f" .json)
        local n=$(python3 -c "import json,sys; print(len(json.load(open(sys.argv[1]))))" "$f" 2>/dev/null || echo 0)
        printf "  %-30s %3d stars\n" "$bucket" "$n"
        total=$((total + n))
    done
    echo "─────────────────────────────────────────"
    echo "  Total: $total"
    echo ""
}

# === theme ===
cmd_theme() {
    local action="$1"
    shift
    case "$action" in
        add)
            python3 "$SCRIPTS_DIR/add_theme.py" --work "$WORK" --interactive
            ;;
        list)
            local events="$WORK/_meta/events.yaml"
            if [ ! -f "$events" ]; then
                warn "No events.yaml"
                return
            fi
            python3 "$SCRIPTS_DIR/add_theme.py" --work "$WORK" --list
            ;;
        remove)
            local name="$1"
            [ -z "$name" ] && { err "Usage: picvault theme remove <name>"; return 1; }
            local events="$WORK/_meta/events.yaml"
            [ -f "$events" ] || { warn "No events.yaml"; return; }
            python3 "$SCRIPTS_DIR/add_theme.py" --work "$WORK" --remove "$name"
            ;;
        rebucket)
            local yes="" all="" themes=()
            while [ $# -gt 0 ]; do
                case "$1" in
                    --yes) yes=1; shift ;;
                    --all) all=1; shift ;;
                    --theme)
                        shift
                        [ -z "${1:-}" ] && { err "Usage: picvault theme rebucket --theme <name> [--yes]"; return 1; }
                        themes+=("$1"); shift ;;
                    *)
                        err "Unknown arg: $1"
                        err "Usage: picvault theme rebucket --theme <name> [--yes]  OR  --all [--yes]"
                        return 1 ;;
                esac
            done
            if [ -z "$all" ] && [ ${#themes[@]} -eq 0 ]; then
                err "Specify --theme <name> and/or --all"
                err "  One theme:  picvault theme rebucket --theme 香港-深圳 [--yes]"
                err "  All themes: picvault theme rebucket --all [--yes]  (may overwrite manual moves)"
                return 1
            fi
            local args=(--work "$WORK" --rebucket-themes)
            if [ -n "$all" ]; then
                args+=(--all)
            fi
            for t in "${themes[@]}"; do
                args+=(--theme "$t")
            done
            if [ -n "$yes" ]; then
                python3 "$SCRIPTS_DIR/rename_organize.py" "${args[@]}"
            else
                python3 "$SCRIPTS_DIR/rename_organize.py" "${args[@]}" --dry-run
                echo ""
                if [ -n "$all" ]; then
                    info "Dry-run only. Re-run: picvault theme rebucket --all --yes"
                else
                    info "Dry-run only. Re-run with --yes to apply (same --theme flags)"
                fi
            fi
            ;;
        *)
            err "Usage: picvault theme {add|list|remove <name>|rebucket --theme <name>|rebucket --all} [--yes]"
            ;;
    esac
}

# === find ===
cmd_find() {
    local pattern="$1"
    shift
    local date_filter=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --date) date_filter="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    if [ -n "$date_filter" ]; then
        local y=${date_filter:0:4}
        local m=${date_filter:5:2}
        local d=${date_filter:8:2}
        local target="$WORK/by-date/$y/$y-$m/$y-$m-$d"
        if [ -d "$target" ]; then
            info "Files in $target:"
            find "$target" -type f 2>/dev/null | head -100
        else
            warn "No such date: $target"
        fi
    elif [ -n "$pattern" ]; then
        info "Searching for '$pattern' in by-date/ ..."
        find "$WORK/by-date" -name "*${pattern}*" -type f 2>/dev/null | head -50
    else
        err "Usage: picvault find <pattern>  OR  picvault find --date YYYY-MM-DD"
    fi
}

# === log ===
cmd_log() {
    local latest=$(ls -t "$WORK/_meta/logs/"*.log 2>/dev/null | head -1)
    if [ -z "$latest" ]; then
        warn "No logs in $WORK/_meta/logs/"
        return
    fi
    info "Tailing $latest"
    tail -50 "$latest"
}

# === doctor ===
cmd_doctor() {
    echo ""
    echo -e "${BOLD}🔍 PicVault Doctor${NC}"
    echo "─────────────────────────────────────────"
    
    # Python
    if command -v python3 >/dev/null 2>&1; then
        local py=$(python3 --version 2>&1)
        ok "Python: $py"
    else
        err "Python 3 not found"
    fi
    
    # PIL
    if python3 -c "import PIL" 2>/dev/null; then
        ok "PIL: $(python3 -c 'import PIL; print(PIL.__version__)')"
    else
        err "PIL not installed (pip3 install --user Pillow)"
    fi
    
    # ffmpeg
    if command -v ffmpeg >/dev/null 2>&1; then
        ok "ffmpeg: $(ffmpeg -version 2>&1 | head -1 | cut -d' ' -f3)"
    else
        err "ffmpeg not found (brew install ffmpeg)"
    fi
    
    # ffprobe
    if command -v ffprobe >/dev/null 2>&1; then
        ok "ffprobe: $(ffprobe -version 2>&1 | head -1 | cut -d' ' -f3)"
    else
        err "ffprobe not found"
    fi
    
    # sips (macOS only)
    if command -v sips >/dev/null 2>&1; then
        ok "sips: $(sips --version 2>&1 | head -1)"
    else
        warn "sips not found (macOS only — needed for Web UI thumbnails)"
    fi
    
    # Work directory
    if [ -d "$WORK" ]; then
        ok "Work directory: $WORK (writable: $([ -w "$WORK" ] && echo yes || echo NO))"
    else
        err "Work directory does not exist: $WORK"
    fi
    
    # Backup directory
    if [ -d "/Volumes/WD4T/MediaVault" ]; then
        ok "Backup directory: /Volumes/WD4T/MediaVault"
    else
        warn "Backup directory not mounted: /Volumes/WD4T/MediaVault"
    fi
    
    echo "─────────────────────────────────────────"
    echo ""
}

# === main ===
main() {
    # Global options: picvault [--work PATH] <command> ...
    while [ $# -gt 0 ]; do
        case "$1" in
            --work)
                if [ -z "${2:-}" ]; then
                    err "--work requires a path"
                    return 1
                fi
                WORK="$2"
                shift 2
                ;;
            --help|-h)
                cmd_help
                return 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                err "Unknown global option: $1"
                err "  Global options: --work PATH"
                err "  Usage: picvault [--work PATH] <command> ..."
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    if [ $# -eq 0 ]; then
        cmd_help
        return
    fi

    local cmd="$1"
    shift

    # Reject --work after the command (do not silently ignore) — before disk checks
    local a
    for a in "$@"; do
        if [ "$a" = "--work" ]; then
            err "--work must come before the command: picvault --work PATH $cmd ..."
            return 1
        fi
    done

    if _needs_work_check "$cmd"; then
        check_path "$WORK" "work"
    fi

    case "$cmd" in
        help|-h|--help)
            cmd_help
            ;;
        status)
            cmd_status "$@"
            ;;
        init)
            cmd_init "$@"
            ;;
        dedupe)
            cmd_dedupe "$@"
            ;;
        rename)
            cmd_rename "$@"
            ;;
        sync)
            cmd_sync "$@"
            ;;
        pipeline)
            cmd_pipeline "$@"
            ;;
        web)
            cmd_web "$@"
            ;;
        star)
            cmd_star "$@"
            ;;
        unstar)
            cmd_unstar "$@"
            ;;
        favorites)
            cmd_favorites
            ;;
        theme)
            cmd_theme "$@"
            ;;
        find)
            cmd_find "$@"
            ;;
        log)
            cmd_log
            ;;
        doctor)
            cmd_doctor
            ;;
        open)
            cmd_web open
            ;;
        *)
            err "Unknown command: $cmd"
            info "Run 'picvault help' for usage"
            return 1
            ;;
    esac
}

main "$@"
