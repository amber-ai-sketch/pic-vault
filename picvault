#!/bin/bash
# picvault - Personal photo/video library CLI
# Usage: picvault <subcommand> [args]
# Run `picvault help` for full command list.

set -e

# ============================================================
# Config
# ============================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts"
# Explicit WORK / PICVAULT_WORK wins; else config file; else default.
CONFIG_FILE="${PICVAULT_CONFIG:-$HOME/.config/picvault/work}"
if [ -n "${WORK:-}" ] || [ -n "${PICVAULT_WORK:-}" ]; then
    WORK="${WORK:-$PICVAULT_WORK}"
elif [ -f "$CONFIG_FILE" ]; then
    WORK="$(cat "$CONFIG_FILE")"
else
    WORK="/Volumes/Storage"
fi

# Path whitelist (sandbox)
ALLOWED_PREFIXES=(
    "/Volumes/Storage"
    "/Volumes/WD4T/MediaVault"
    "/Volumes/YM/MediaVault"
    "/Users/ym/Downloads/pic-test"
)

# Test bypass
if [ "${PICVAULT_TEST:-}" = "1" ]; then
    PICVAULT_SANDBOX_BYPASS=1
fi

# ============================================================
# Colors
# ============================================================
if [ -t 1 ]; then
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    GREEN=''; YELLOW=''; RED=''; BLUE=''; BOLD=''; NC=''
fi

ok()    { echo -e "${GREEN}✓${NC} $*" >&2; }
warn()  { echo -e "${YELLOW}⚠${NC}  $*" >&2; }
err()   { echo -e "${RED}❌${NC} $*" >&2; }
info()  { echo -e "${BLUE}ℹ${NC}  $*" >&2; }

# ============================================================
# Path sandbox
# ============================================================
_canonicalize() {
    python3 -c 'import os,sys; print(os.path.realpath(os.path.abspath(sys.argv[1])))' "$1"
}

check_path() {
    local p="$1"
    local kind="$2"
    [ "${PICVAULT_SANDBOX_BYPASS:-0}" = "1" ] && return 0
    # Resolve .. / symlinks before prefix match (blocks /Volumes/Storage/../../Users/...)
    local resolved
    if ! resolved="$(_canonicalize "$p")"; then
        err "--$kind $p could not be resolved"
        exit 1
    fi
    local prefix prefix_r
    for prefix in "${ALLOWED_PREFIXES[@]}"; do
        prefix_r="$(_canonicalize "$prefix" 2>/dev/null || echo "$prefix")"
        if [[ "$resolved" == "$prefix_r" || "$resolved" == "$prefix_r"/* ]]; then
            # Update caller’s path to canonical form when checking WORK
            if [[ "$kind" == "work" ]]; then
                WORK="$resolved"
            fi
            return 0
        fi
    done
    err "--$kind $p is not in path whitelist (resolved: $resolved)"
    err "  Allowed: ${ALLOWED_PREFIXES[*]}"
    exit 1
}

sanitize_bucket() {
    local bucket="$1"
    if [[ -z "$bucket" || "$bucket" == "." || "$bucket" == ".." ]]; then
        err "invalid bucket: ${bucket:-<empty>}"
        return 1
    fi
    if [[ "$bucket" == *"/"* || "$bucket" == *"\\"* || "$bucket" == *".."* ]]; then
        err "invalid bucket (no path separators or '..'): $bucket"
        return 1
    fi
    return 0
}

resolve_work_rel_path() {
    local raw="$1"
    local require_file="${2:-0}"
    python3 - "$WORK" "$raw" "$require_file" <<'PY'
import os
import sys
from pathlib import Path

work = Path(sys.argv[1]).expanduser().resolve()
raw = sys.argv[2] if len(sys.argv) > 2 else ''
require_file = (sys.argv[3] == '1') if len(sys.argv) > 3 else False

if not raw or '\0' in raw:
    print('invalid file path', file=sys.stderr)
    sys.exit(1)

p = Path(raw).expanduser()
if p.is_absolute():
    full = p.resolve()
else:
    if '..' in p.parts:
        print('path escapes work', file=sys.stderr)
        sys.exit(1)
    full = (work / p).resolve()

if full != work and not str(full).startswith(str(work) + os.sep):
    print(f'path outside work: {raw}', file=sys.stderr)
    sys.exit(1)

if require_file and not full.is_file():
    print(f'path not found: {raw}', file=sys.stderr)
    sys.exit(1)

print(os.path.relpath(full, work))
PY
}

# Path check is deferred for commands that do not need a work disk
# (help / doctor). Others still sandbox WORK after global --work parsing.
_needs_work_check() {
    case "${1:-}" in
        help|-h|--help|doctor) return 1 ;;
        *) return 0 ;;
    esac
}

# ============================================================
# Helpers
# ============================================================
count_files() {
    local dir="$1"
    [ -d "$dir" ] || { echo 0; return; }
    find "$dir" -type f -not -path "*/.DS_Store" 2>/dev/null | wc -l | tr -d ' '
}

count_starred() {
    local dir="$1"
    [ -d "$dir" ] || { echo 0; return; }
    local count=0
    for f in "$dir"/*.json; do
        [ -f "$f" ] || continue
        local n=$(python3 -c "import json,sys; print(len(json.load(open(sys.argv[1]))))" "$f" 2>/dev/null || echo 0)
        count=$((count + n))
    done
    echo $count
}

last_sync_time() {
    local log_dir="$1"
    [ -d "$log_dir" ] || { echo "never"; return; }
    find "$log_dir" -name "sync-*.log" 2>/dev/null | sort -r | head -1
}

web_current_port() {
    local port_file="$WORK/_meta/web.port"
    [ -f "$port_file" ] || return 1
    local p
    p="$(cat "$port_file" 2>/dev/null)" || return 1
    case "$p" in
        ''|*[!0-9]*) return 1 ;;
        *) echo "$p" ;;
    esac
}

# ============================================================
# Commands
# ============================================================

